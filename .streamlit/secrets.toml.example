# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored), or paste the contents into
# Streamlit Community Cloud > App settings > Secrets. Keys are upper-cased into environment variables.
GROQ_API_KEY = "your_groq_key"
GROQ_MODEL = "openai/gpt-oss-20b"
GROQ_FALLBACK_MODELS = "openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-safeguard-20b"
ANSWER_MODEL = "qwen/qwen3.8-27b"

NEO4J_URI = "neo4j+s://<your-instance-id>.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "your_aura_password"
NEO4J_DATABASE = "neo4j"

# Keep public daily caps low: they protect the free Groq quota.
DAILY_ASK_BUDGET = "60"
DAILY_CHUNK_BUDGET = "100"
